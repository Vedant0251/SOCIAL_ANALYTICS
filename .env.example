# BrandPulse AI Environment Configuration
# Copy this file to .env and adjust variables as needed

# Kaggle API Credentials (Optional fallback if ~/.kaggle/kaggle.json is absent)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional API keys for External Scrapers & API Ingestion (Wrappers degrade gracefully if absent)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BrandPulseAI/1.0
TWITTER_BEARER_TOKEN=

# System / Hardware Settings
TORCH_DEVICE=cuda
RANDOM_SEED=42
CACHE_DIR=cache
LOG_LEVEL=INFO
